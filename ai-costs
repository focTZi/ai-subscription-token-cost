#!/usr/bin/env python3
"""Run ai-costs from a checkout without installing it."""
from pathlib import Path
import sys

if sys.version_info < (3, 9):
    sys.exit("ai-costs needs Python 3.9 or newer.")
sys.path.insert(0, str(Path(__file__).resolve().parent))

from ai_costs.cli import main  # noqa: E402

sys.exit(main())
